{
    "name": "fox-preview-image",
    "version": "3.4.0",
    "description": "一个支持 vue3 的预览图片组件",
    "type": "module",
    "license": "MIT",
    "sideEffects": false,
    "keywords": [
        "frontend",
        "previewImage",
        "preview",
        "image",
        "imagePreview",
        "fox",
        "preview-image"
    ],
    "homepage": "https://github.com/GuoJikun/preview-image",
    "bugs": {
        "url": "https://github.com/GuoJikun/preview-image/issues",
        "email": "guojikun486546@163.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/GuoJikun/preview-image.git"
    },
    "author": "GuoJiKun <guojikun486546@163.com>",
    "files": [
        "dist",
        "package.json"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./index.css": "./dist/index.css",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "play": "vite",
        "typecheck": "vue-tsc --noEmit",
        "release": "bumpp && pnpm publish",
        "prepublishOnly": "pnpm run build"
    },
    "peerDependencies": {
        "vue": "^3.0.0"
    },
    "devDependencies": {
        "@tsdown/css": "^0.22.14",
        "@types/node": "^24.7.2",
        "@vitejs/plugin-vue": "^6.0.8",
        "bumpp": "^10.4.1",
        "sass-embedded": "^1.103.1",
        "tsdown": "^0.22.14",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vue": "^3.5.22",
        "vue-tsc": "^3.3.11"
    }
}